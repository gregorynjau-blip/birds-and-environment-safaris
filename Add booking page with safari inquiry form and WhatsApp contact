<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Book Your Safari | Birds and Environment Safaris</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#f4f7f2;
    color:#333;
}

header{
    background:#1b5e20;
    color:white;
    text-align:center;
    padding:60px 20px;
}

header h1{
    font-size:40px;
    margin-bottom:10px;
}

.container{
    max-width:900px;
    margin:40px auto;
    background:white;
    padding:35px;
    border-radius:10px;
    box-shadow:0 5px 15px rgba(0,0,0,.15);
}

label{
    display:block;
    margin-top:18px;
    margin-bottom:8px;
    font-weight:bold;
}

input,
select,
textarea{
    width:100%;
    padding:12px;
    border:1px solid #ccc;
    border-radius:6px;
    font-size:16px;
}

textarea{
    resize:vertical;
}

button{
    width:100%;
    margin-top:30px;
    padding:15px;
    background:#1b5e20;
    color:white;
    border:none;
    border-radius:6px;
    font-size:18px;
    cursor:pointer;
}

button:hover{
    background:#145214;
}

.contact{
    margin-top:40px;
    text-align:center;
    background:#eef7ea;
    padding:25px;
    border-radius:8px;
}

footer{
    margin-top:40px;
    background:#222;
    color:white;
    text-align:center;
    padding:25px;
}
</style>
</head>

<body>

<header>
<h1>Book Your Tanzania Safari</h1>
<p>Start planning your unforgettable wildlife adventure.</p>
</header>

<div class="container">

<form action="https://formsubmit.co/birdsandenvironment@outlook.com" method="POST">

<input type="hidden" name="_subject" value="New Safari Booking Inquiry">
<input type="hidden" name="_captcha" value="false">

<label>Full Name</label>
<input type="text" name="Name" required>

<label>Email Address</label>
<input type="email" name="Email" required>

<label>WhatsApp Number</label>
<input type="tel" name="WhatsApp" required>

<label>Country</label>
<input type="text" name="Country">

<label>Preferred Safari</label>
<select name="Safari">
<option>Mikumi National Park</option>
<option>Nyerere National Park</option>
<option>Ruaha National Park</option>
<option>Saadani National Park</option>
<option>Udzungwa Mountains</option>
<option>Custom Safari</option>
</select>

<label>Preferred Travel Date</label>
<input type="date" name="Travel Date">

<label>Number of Guests</label>
<input type="number" name="Guests" min="1">

<label>Special Requests</label>
<textarea name="Message" rows="6" placeholder="Tell us about your dream safari..."></textarea>

<button type="submit">Send Booking Inquiry</button>

</form>

<div class="contact">

<h2>Need Immediate Assistance?</h2>

<p><strong>WhatsApp:</strong> +255 716 108 475</p>

<p><strong>Email:</strong> birdsandenvironment@outlook.com</p>

<p><strong>Location:</strong> Dar es Salaam, Tanzania</p>

<br>

<a href="https://wa.me/255716108475" target="_blank" style="display:inline-block;background:#25D366;color:white;padding:14px 28px;text-decoration:none;border-radius:6px;font-weight:bold;">
Chat on WhatsApp
</a>

</div>

</div>

<footer>

<h3>Birds and Environment Safaris</h3>

<p>Discover Tanzania. Experience Nature. Create Memories.</p>

<p style="margin-top:10px;">© 2026 Birds and Environment Safaris. All Rights Reserved.</p>

</footer>

</body>
</html>
